# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# JWT secret (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here

# Optional: OpenAI API for AI-powered deal extraction
OPENAI_API_KEY=sk-your-key-here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Firebase Cloud Messaging (Push Notifications)
# Option 1: JSON string of the service account key (recommended for Railway/Docker)
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Option 2: Path to the service account JSON file
# FIREBASE_CREDENTIALS=/path/to/serviceAccountKey.json
